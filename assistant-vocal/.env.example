# Copier en .env (jamais commité) puis remplir.
VAPI_API_KEY=
# Laisser vide au premier lancement : le script crée l'assistant et affiche son ID.
VAPI_ASSISTANT_ID=
# Optionnel : lire les tarifs dans l'onglet "Tarifs" du Google Sheet du dashboard
# au lieu de donnees/tarifs.csv.
GOOGLE_API_KEY=
SPREADSHEET_ID=
SHEET_TARIFS=Tarifs
# Modèle utilisé par l'assistant (vérifier la liste proposée par Vapi).
VAPI_MODEL_PROVIDER=anthropic
VAPI_MODEL=claude-haiku-5-5
