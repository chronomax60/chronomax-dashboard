# Copier en .env (jamais commité) puis remplir.
VAPI_API_KEY=
# Optionnel : sinon l ID enregistré dans donnees/vapi.json est utilisé.
VAPI_ASSISTANT_ID=
# Source des tarifs : site (chronomax.fr, par défaut), sheet (Google Sheet) ou csv (donnees/tarifs.csv).
TARIFS_SOURCE=site
# Ne garder que les tarifs dont la marque/le modèle contient ce mot (vide = tout).
TARIFS_FILTRE=iphone
# Optionnel : lire les tarifs dans l'onglet "Tarifs" du Google Sheet du dashboard
# au lieu de donnees/tarifs.csv.
GOOGLE_API_KEY=
SPREADSHEET_ID=
SHEET_TARIFS=Tarifs
# Modèle utilisé par l'assistant (vérifier la liste proposée par Vapi).
VAPI_MODEL_PROVIDER=anthropic
VAPI_MODEL=claude-haiku-5-5
# Voix (par défaut : Azure, voix française féminine Denise).
VAPI_VOICE_PROVIDER=azure
VAPI_VOICE_ID=fr-FR-DeniseNeural
